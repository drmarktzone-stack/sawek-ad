# Vertex AI Gemini Pro + Flash + Imagen 3 + Cloud Translation. Same $300 Google Cloud pack.
# Cloud Run: Application Default Credentials via the compute service account (no password).
# Default project in code: project-8fd8a005-ae6d-4139-ab4.
GOOGLE_CLOUD_PROJECT=project-8fd8a005-ae6d-4139-ab4
VERTEX_LOCATION=us-central1
# Optional local ADC JSON path (never commit the file). Cloud Run does not need this.
# GOOGLE_APPLICATION_CREDENTIALS=
#
# Model mapping (Gemini 1.5 retired on Vertex):
#   gemini-1.5-pro   → gemini-2.5-pro    (CMO / audit / calendar / scripts)
#   gemini-1.5-flash → gemini-2.5-flash  (burst variations)
#   Imagen 3         → imagen-3.0-generate-001
#   Translation      → Cloud Translation API v3 (HE ↔ AR ↔ EN)
# Status: GET /api/gemini-status  and  /status
# Viral-desk (next PR) calls lib/gcp-ai.ts — Pro/Flash/Imagen/Translation + Search Grounding.
# Brand voice: in-memory now. Firestore collection brand_voices when that PR lands.

# Optional Programmable Search (Custom Search JSON API) for live Google image results.
# Image search must be enabled on the engine. Leave empty — the app uses Openverse + Wikimedia.
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# Stripe Checkout (runtime only — never commit real keys).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Optional PayPal.me if Stripe PayPal is off. Example: https://paypal.me/yourname
PAYPAL_ME=

# Bank / Bit instructions shown on /billing/bank. Leave empty — do not invent IBAN.
BANK_INSTRUCTIONS=
BIT_INSTRUCTIONS=

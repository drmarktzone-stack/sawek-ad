# Optional. The app runs with none of these.

# Optional AI Studio key. Vertex on the GCP pack is preferred and tried first.
GEMINI_API_KEY=

# Optional campaign sync. localStorage is the default.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Social OAuth (Facebook Login / Instagram Graph, LinkedIn). Never commit real values.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=https://sawek-ad-308665814452.me-west1.run.app

# Vertex AI Gemini Pro + Flash + Imagen 3 + Cloud Translation. Same $300 Google Cloud pack.
# Cloud Run: Application Default Credentials via the compute service account (no password).
# Default project in code: project-8fd8a005-ae6d-4139-ab4.
GOOGLE_CLOUD_PROJECT=project-8fd8a005-ae6d-4139-ab4
VERTEX_LOCATION=us-central1
# Optional local ADC JSON path (never commit the file). Cloud Run does not need this.
# GOOGLE_APPLICATION_CREDENTIALS=
#
# Model mapping (Gemini 1.5 retired on Vertex):
#   gemini-1.5-pro   → gemini-2.5-pro    (CMO / audit / calendar / scripts)
#   gemini-1.5-flash → gemini-2.5-flash  (burst variations)
#   Imagen 3         → imagen-3.0-generate-001
#   Translation      → Cloud Translation API v3 (HE ↔ AR ↔ EN)
# Status: GET /api/gemini-status  and  /status
# Viral-desk (next PR) calls lib/gcp-ai.ts — Pro/Flash/Imagen/Translation + Search Grounding.
# Brand voice: in-memory now. Firestore collection brand_voices when that PR lands.

# Optional Programmable Search (Custom Search JSON API) for live Google image results.
# Image search must be enabled on the engine. Leave empty — the app uses Openverse + Wikimedia.
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# Stripe Checkout (runtime only — never commit real keys).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# PayPal Business for drmarktzone@gmail.com is permanently deactivated.
# Do not set PAYPAL_ME. Live checkout never enables PayPal / paypal.me.
# PAYPAL_ME=
# PAYPAL_ENABLED=false

# Bit + Bank Hapoalim — public receive details shown to customers on /pricing.
# Cloud Run: set the same values (or override). Do not invent an IBAN.
BIT_PHONE=052-8885800
BANK_NAME=בנק הפועלים
BANK_NAME_EN=Bank Hapoalim
BANK_CODE=12
BANK_BRANCH=666
BANK_ACCOUNT=422494
BANK_HOLDER=ד״ר סאמר / Drmarktzone (Markt)
# Optional free-text notes. Leave empty — the app builds Hebrew instructions from the fields above.
BANK_INSTRUCTIONS=
BIT_INSTRUCTIONS=
# BANK_IBAN=   # do not set unless you have a real IBAN; the UI will not invent one

# Public site URL for canonical / Open Graph / sitemap (defaults to the Cloud Run host).
NEXT_PUBLIC_SITE_URL=https://sawek-ad-308665814452.me-west1.run.app

# Optional analytics. Leave empty — nothing is loaded. No fake tracking.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Plausible site domain, e.g. sawek-ad.example
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional Sentry browser DSN. Leave empty — Sentry is not bundled and not required.
# If you later add @sentry/nextjs yourself, this is the env name to use. No paid plan needed for a free DSN.
NEXT_PUBLIC_SENTRY_DSN=
